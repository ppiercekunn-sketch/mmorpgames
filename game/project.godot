; Engine configuration file.
; Godot 4.3. Edit through the editor where possible.

config_version=5

[application]

config/name="Pockie Saints Remake"
config/description="Browser MMORPG vertical slice (MVP)."
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Events="*res://core/events.gd"
GameData="*res://core/game_data.gd"
Session="*res://core/session.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

